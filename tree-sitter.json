{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "kof",
      "camelcase": "Kof",
      "title": "Kof",
      "scope": "source.kof",
      "file-types": [
        "kof",
        "kf"
      ],
      "injection-regex": "^kof$",
      "class-name": "TreeSitterKof"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Kof tree-sitter and higligth parser",
    "authors": [
      {
        "name": "Emerson A. Tieppo Jr.",
        "email": "tieppo.emerson.a.jr@gmail.com",
        "url": "https://github.com/etieppo"
      }
    ],
    "links": {
      "repository": "https://github.com/etieppo/tree-sitter-kof",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}